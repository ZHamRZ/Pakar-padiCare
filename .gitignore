```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
dist/
build/
*.class
*.exe
*.dll
*.so
*.a
*.out

# Dependencies
node_modules/
vendor/
*.lock
composer.lock
package-lock.json
yarn.lock
pnpm-lock.yaml

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Environment
.env
.env.local
.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# Python specific
*.pyc
__pycache__/
.pytest_cache/
.mypy_cache/

# PHP specific
vendor/
composer.lock

# Laravel/Hydrated views
storage/
bootstrap/cache/

# Build directories
target/
.gradle/
```